# Reusable CLI image, with dependencies from this repository's reviewed lock.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /usr/local/bin/

RUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*

# Keep CLI dependencies outside the directory used for mounted projects.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LOCKED=true \
    UV_NO_DEV=true \
    PATH="/usr/local/bin:/opt/venv/bin:${PATH}"
WORKDIR /opt/crewai-lock
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

WORKDIR /work
ENTRYPOINT ["crewai"]
